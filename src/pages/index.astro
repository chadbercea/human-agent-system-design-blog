---
import { getCollection } from 'astro:content';
import ArticleListView from '../components/ArticleListView.astro';

/* Homepage renders the same article list as `/blog`. ILI-828 —
   pagination is client-side now; there are no /blog/2 routes.
   ArticleListView receives the full sorted list and lets JS
   swap the visible slice when the pagination buttons are
   clicked. */
const PAGE_SIZE = 5;

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<ArticleListView
  articles={articles}
  pageSize={PAGE_SIZE}
  heroVariant="frame"
/>
